# ==========================================================
# Campus Find — Environment Variables Template
# Salin file ini menjadi .env lalu sesuaikan dengan environment lokal Anda.
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT KREDENSIAL/API KEY KE VCS!
# ==========================================================

# Application
APP_NAME=CampusFind
APP_ENV=local
APP_DEBUG=true
APP_URL=http://campusfind-clean.test
# Cara membuat APP_KEY: php -r "echo bin2hex(random_bytes(16));"
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_find
DB_USER=root
DB_PASS=

# Session (Detik, default: 7200 = 2 jam)
SESSION_LIFETIME=7200

# AI & Chatbot Limits (Optional Fallback / Rate Limits)
CFIND_MAX_INPUT_CHARS=300
CFIND_MAX_OUTPUT_TOKENS=500
CFIND_TIMEOUT_SECONDS=60
CFIND_RATE_LIMIT_PER_MIN=10
CFIND_DAILY_TOKEN_BUDGET=50000
CFIND_HISTORY_RETENTION_DAYS=30

# Demo Account Passwords (Local / Testing Only)
DEMO_ADMIN_PASSWORD=
DEMO_PETUGAS_PASSWORD=
DEMO_CIVITAS_PASSWORD=

# Feature Toggles
PUBLIC_BROWSE_ENABLED=false

# Notification & Email SMTP Settings (Fallback / Default)
SMTP_HOST=
SMTP_PORT=
SMTP_ENCRYPTION=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
NOTIFY_ALLOWLIST=
NOTIFY_DAILY_LIMIT=100
